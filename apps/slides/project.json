{
  "name": "slides",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/slides",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "npx slidev slides.md",
        "cwd": "apps/slides"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx slidev build slides.md --out ../../dist/apps/slides",
        "cwd": "apps/slides",
        "outputs": ["{workspaceRoot}/dist/apps/slides"]
      }
    },
    "export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx slidev export slides.md --output ../../dist/apps/slides/chrome-devtools-workshop.pdf",
        "cwd": "apps/slides",
        "outputs": ["{workspaceRoot}/dist/apps/slides/chrome-devtools-workshop.pdf"]
      }
    }
  }
}
